{
  "name": "reader-001",
  "version": "1.0.0",
  "description": "Paste an article URL, get a clean reader view - no images, no ads, just text.",
  "main": "server.js",
  "type": "commonjs",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --target node22-win-x64 --output dist/Reader.exe && node -e \"require('fs').copyFileSync('Reader.vbs','dist/Reader.vbs')\""
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "express": "^4.19.2",
    "jsdom": "^24.1.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist"
  }
}
